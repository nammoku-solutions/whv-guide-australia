# --- Supabase (required for auth, forum, feedback, moderation) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API -> Project API keys -> anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL (used for canonical URLs, sitemap, robots, OG tags) ---
# Production example: https://whv-guide-australia.com
# Leave empty locally to fall back to the Vercel/default URL.
NEXT_PUBLIC_SITE_URL=

# --- Google AdSense ad unit slot ids (optional) ---
# Create ad units in AdSense, then paste their data-ad-slot ids here.
# When empty, ad areas render nothing (no placeholder boxes).
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# --- Discord notifications (optional) ---
# Discord channel -> Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# When a report or feedback/request is submitted, a message is posted to this channel.
# Server-side only (do NOT prefix with NEXT_PUBLIC). Leave empty to disable notifications.
DISCORD_WEBHOOK_URL=

# =====================================================================
# Site AI assistant (RAG). All server-side. NEVER prefix AI keys with NEXT_PUBLIC.
# =====================================================================
# Supabase service-role key (Project Settings -> API -> service_role). Required
# for AI retrieval, rate limiting, feedback and the indexing pipeline.
SUPABASE_SERVICE_ROLE_KEY=
# Google Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=

# --- Provider & models (change models here, not in code) ---
AI_PROVIDER=gemini
# Default low-cost generation model for high-volume site Q&A.
AI_GENERATION_MODEL=gemini-2.5-flash-lite
# Optional more capable model for future complex/high-risk routing (Phase 4).
AI_GENERATION_MODEL_COMPLEX=gemini-2.5-flash
# Multilingual embedding model (strong Japanese). 768-dim (normalized).
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
# Bump this and run `npm run ai:reindex` when changing the embedding model.
AI_EMBEDDING_VERSION=v1

# --- Feature flags (V1: all OFF) ---
AI_RERANK_ENABLED=false
AI_VERIFY_ENABLED=false
AI_COMPLEX_ROUTING_ENABLED=false
AI_MARKETPLACE_SEARCH_ENABLED=false
AI_HYBRID_SEARCH_ENABLED=false

# --- Retrieval / cost controls ---
AI_MAX_CONTEXT_CHUNKS=5
AI_SIMILARITY_THRESHOLD=0.62
AI_MAX_DAILY_ANON_REQUESTS=5
AI_MAX_DAILY_AUTH_REQUESTS=20
AI_MAX_QUESTION_LENGTH=500
# Salt for privacy-preserving anonymous IP hashing in rate limiting. Set a random
# value in production (do NOT leave the default).
AI_RATE_LIMIT_SALT=
