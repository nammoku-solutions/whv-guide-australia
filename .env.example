# --- Supabase (auth, forum, marketplace, feedback, moderation) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=

# --- Google AdSense ad unit slot ids (optional) ---
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# --- Discord notifications (optional) ---
DISCORD_WEBHOOK_URL=

# --- Server-side Supabase ---
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# AI / automated-news runtime status
# =====================================================================
# No external model provider is configured in the application runtime.
# Keep these false until a separately selected API provider is implemented,
# reviewed, and explicitly enabled.
AI_RUNTIME_ENABLED=false
NEWS_AI_AUTOMATION_ENABLED=false

# Weekly official-source research is operated outside the repository by the
# ChatGPT scheduled task. It does not require a model API key in this project.

# Optional candidate-ingest endpoint. Leave the secret empty to keep the route
# disabled (recommended while downstream AI candidate processing is paused).
EXTERNAL_NEWS_INGEST_SECRET=
EXTERNAL_NEWS_INGEST_RATE_MAX=30
