# --- Supabase (auth, forum, marketplace, feedback, moderation) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=

# --- Google AdSense ad unit slot ids (optional) ---
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# --- Discord notifications (optional) ---
DISCORD_WEBHOOK_URL=

# --- Server-side Supabase ---
# Preferred current Supabase server key. Keep backend-only; never expose to the browser.
SUPABASE_SECRET_KEY=
# Legacy fallback during migration.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# Site AI assistant (Gemini RAG)
# =====================================================================
# Server-side only. Never prefix this key with NEXT_PUBLIC_ .
GEMINI_API_KEY=
AI_RUNTIME_ENABLED=true
AI_PROVIDER=gemini
AI_GENERATION_MODEL=gemini-3.5-flash-lite
AI_GENERATION_MODEL_COMPLEX=gemini-3.5-flash
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_EMBEDDING_VERSION=v1
AI_RERANK_ENABLED=false
AI_VERIFY_ENABLED=false
AI_COMPLEX_ROUTING_ENABLED=false
AI_MARKETPLACE_SEARCH_ENABLED=true
AI_HYBRID_SEARCH_ENABLED=true
AI_STRUCTURED_DATA_ENABLED=true
AI_PERSONAL_DATA_ENABLED=true
AI_CURRENT_UPDATES_ENABLED=true
AI_MUTATIONS_ENABLED=false
AI_MAX_CONTEXT_CHUNKS=5
AI_SIMILARITY_THRESHOLD=0.62
AI_KEYWORD_CANDIDATES=20
AI_RRF_K=60
AI_MAX_DAILY_ANON_REQUESTS=5
AI_MAX_DAILY_AUTH_REQUESTS=20
AI_MAX_QUESTION_LENGTH=500
AI_RATE_LIMIT_SALT=

# =====================================================================
# Automated news runtime
# =====================================================================
# Keep AI-backed news generation disabled. Weekly official-source research is
# operated separately through the ChatGPT scheduled task.
NEWS_AI_AUTOMATION_ENABLED=false

# Optional candidate-ingest endpoint. Leave the secret empty while downstream
# automated candidate processing remains paused.
EXTERNAL_NEWS_INGEST_SECRET=
EXTERNAL_NEWS_INGEST_RATE_MAX=30
