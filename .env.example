# --- Supabase (required for auth, forum, feedback, moderation) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=

# --- Google AdSense ad unit slot ids (optional) ---
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# --- Discord notifications (optional) ---
DISCORD_WEBHOOK_URL=

# --- Server-side Supabase ---
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# Site AI status
# =====================================================================
# Gemini has been retired from WHV Compass. The public site AI assistant and
# AI indexing/AI-backed news processing are intentionally disabled until a new
# runtime provider is selected. ChatGPT Plus is used only for operator-side
# scheduled research; it does not provide API credentials for this application.

# Non-provider AI settings are retained so the existing RAG implementation can
# be re-enabled later without losing tuning values.
AI_EMBEDDING_VERSION=v1
AI_RERANK_ENABLED=false
AI_VERIFY_ENABLED=false
AI_COMPLEX_ROUTING_ENABLED=false
AI_MARKETPLACE_SEARCH_ENABLED=false
AI_HYBRID_SEARCH_ENABLED=true
AI_MAX_CONTEXT_CHUNKS=5
AI_SIMILARITY_THRESHOLD=0.62
AI_KEYWORD_CANDIDATES=20
AI_RRF_K=60
AI_MAX_DAILY_ANON_REQUESTS=5
AI_MAX_DAILY_AUTH_REQUESTS=20
AI_MAX_QUESTION_LENGTH=500
AI_RATE_LIMIT_SALT=
